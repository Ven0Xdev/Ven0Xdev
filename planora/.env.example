# --- מסד נתונים ---
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/planora?schema=public"

# --- Auth.js ---
# יצירת מפתח: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- כניסת הדגמה ---
# מאפשרת להיכנס כמשתמש מנתוני ההדגמה ללא Google. לפיתוח והדגמה בלבד.
DEMO_LOGIN_ENABLED="true"

# מנוע ההדמיה התלת-ממדית.
# r3f-webgl (ברירת מחדל) — React Three Fiber שרץ בדפדפן.
# unreal-pixel-streaming — הדמיה פוטוריאליסטית מרוחקת; טרם מומשה, ראו docs/VISUALIZATION.md
NEXT_PUBLIC_VISUALIZATION_PROVIDER=r3f-webgl

# --- אתחול מנהל־העל הראשון (חד־פעמי) ---
# משמשים אך ורק את הפקודה `npm run bootstrap:superadmin`, שרצה בצד השרת.
# אין להם מקבילה בדפדפן ואין להם NEXT_PUBLIC_. אין לשמור כאן ערכים אמיתיים.
# לאחר האתחול יש להסיר את ארבעת המשתנים מהסביבה.
# יצירת סוד: openssl rand -base64 48
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_NAME=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_BOOTSTRAP_SECRET=""

# --- זריעת הדגמה מול מסד מרוחק ---
# ברירת המחדל: סקריפטי ה-seed רצים רק מול מסד מקומי. אין להפעיל בייצור.
# OVIAX_ALLOW_REMOTE_SEED="true"
