# --- App ---
ENVIRONMENT=development
DEBUG=true
# Production: generate a real secret and never reuse this value —
# `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
# main.py refuses to start with this default value when ENVIRONMENT=production.
SECRET_KEY=change-me-in-production

# --- Database ---
# Leave DATABASE_URL unset (or point it at a local SQLite file, as below)
# to run with zero external dependencies — no PostgreSQL install needed.
# The app creates the file and all tables automatically on first startup
# (main.py's lifespan hook calls Base.metadata.create_all()), and an
# empty/fresh database is a normal, non-crashing starting state.
DATABASE_URL=sqlite:///./nexora.db
USE_SQLITE_FALLBACK=true
# For real TimescaleDB/PostgreSQL in production, set DATABASE_URL instead:
# DATABASE_URL=postgresql+psycopg://ven0x:ven0x@localhost:5432/ven0x_otc

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security / Auth (undocumented here = still off by default) ---
# Production deploys reachable from the public internet should set:
#   AUTH_REQUIRED=true          -- every endpoint requires a signed-in user
#   ALLOW_REGISTRATION=true     -- keep true only until YOU have registered
#                                   the first account (which auto-becomes the
#                                   operator/admin), then flip to false so
#                                   strangers can't create their own accounts
#                                   on your public URL
#   RATE_LIMIT_ENABLED=true     -- per-user throttling on expensive endpoints
#   CORS_ORIGINS=https://your-frontend-domain.example  -- the frontend's
#                                   exact deployed origin, not a wildcard.
#                                   Comma-separated for more than one
#                                   origin; a JSON array string also works.
AUTH_REQUIRED=false
ALLOW_REGISTRATION=true
RATE_LIMIT_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Market data provider ---
# mock        = deterministic synthetic demo data (a fictional OTC-flavored
#               dataset — the platform's default zero-config data source),
#               no keys required, fully runnable
# alpaca      = REAL market data (RECOMMENDED). Alpaca (free/Basic plan,
#               IEX feed — real-time, exchange-direct, not delayed) as
#               PRIMARY for quotes/OHLCV/streaming, with AUTOMATIC fallback
#               to Twelve Data on any Alpaca failure (missing key, rate
#               limit, outage, unsupported symbol). Alpha Vantage is used
#               separately as the ONLY source for fundamentals/news/
#               corporate actions (long-TTL cached — these change slowly,
#               so this stays well under its 25-requests/day free quota).
#               Set ALPACA_API_KEY + ALPACA_API_SECRET (PAPER account keys
#               — see the note below) plus TWELVE_DATA_API_KEY and
#               ALPHA_VANTAGE_API_KEY. data_mode carries "live" (fresh IEX
#               data), "cached" (served from the local/Redis TTL cache), or
#               "delayed" (Twelve Data took over); if every vendor fails,
#               the API returns a 503 provider_unavailable response — never
#               fabricated data, and never a silent switch to the mock
#               provider. Free keys:
#               https://alpaca.markets · https://twelvedata.com/pricing ·
#               https://www.alphavantage.co/support/#api-key
# alpaca_only = Alpaca alone, no Twelve Data fallback (fundamentals/news/
#               corporate actions still fail — Alpaca's Data API doesn't
#               supply them on any plan; use "alpaca" above for those).
# finnhub     = REAL market data, fully implemented — set FINNHUB_API_KEY
#               (free key at https://finnhub.io) and switch the line below.
#               Note: bid/ask depth, dilution history and filing flags are not
#               available from Finnhub; those signals run in reduced-info mode.
# twelvedata  = REAL market data. Twelve Data as PRIMARY with AUTOMATIC
#               fallback to Alpha Vantage on any Twelve Data failure (missing
#               key, rate limit, outage, unsupported symbol) — set BOTH
#               TWELVE_DATA_API_KEY and ALPHA_VANTAGE_API_KEY below. Every
#               response carries data_mode "delayed" (fresh vendor call) or
#               "cached" (served from the local TTL cache); if both vendors
#               fail, the API returns a 503 provider_unavailable response —
#               never fabricated data. Free keys:
#               https://twelvedata.com/pricing · https://www.alphavantage.co/support/#api-key
# twelvedata_only = Twelve Data alone, no fallback.
# alphavantage    = Alpha Vantage alone, no fallback.
# polygon | otc_markets = stubs awaiting implementation + API key
MARKET_DATA_PROVIDER=mock
# ENVIRONMENT=production refuses to boot with a synthetic/demo provider
# (data_mode="synthetic", e.g. "mock") unless this is explicitly true — a
# real deployment can never silently end up serving fabricated prices. Not
# checked outside production; local dev/test keep using "mock" for free.
ALLOW_SYNTHETIC_DATA=false
POLYGON_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
OTC_MARKETS_API_KEY=
# Alpaca Market Data API — market-data access ONLY. Nexora never calls
# Alpaca's order-placement/account endpoints (Paper Trading here is fully
# simulated in-app — see PAPER_TRADING_STARTING_BALANCE below), so a PAPER
# account's key pair is all that's ever needed and is the ONLY kind that
# should go here: generate one at https://app.alpaca.markets/paper/dashboard/overview
# (not the live-trading dashboard) → "Generate New Key". Never paste a
# live-trading key pair into this file, even though the Data API itself
# would accept one identically.
ALPACA_API_KEY=
ALPACA_API_SECRET=
SEC_EDGAR_USER_AGENT="Nexora contact@example.com"
NEWS_API_KEY=

# --- Chat assistant ---
# template = fully offline, deterministic, grounded rule-based assistant
#            (default; zero cost, zero external calls — safe for a public
#            deployment with no usage limits of its own)
# llm     = routes to Anthropic; requires ANTHROPIC_API_KEY and bills per
#            message. If this deployment is public, pair it with
#            AUTH_REQUIRED=true and ALLOW_REGISTRATION=false above, or an
#            open link is an open invitation to run up your bill.
CHAT_BACKEND=template
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5
# Reserved for a future OpenAI-backed path — not read by any code yet.
# chat_backend=llm only routes to Anthropic today; setting this alone does
# nothing until that integration exists.
OPENAI_API_KEY=

# --- Continuous scan worker ---
SCAN_INTERVAL_SECONDS=900
# With a free-tier data key (60 calls/min), keep the universe small:
# each analyzed ticker costs ~4 upstream API calls per cold scan.
# 25 tickers ~= one 2-minute first scan; raise once on a paid plan.
UNIVERSE_MAX_TICKERS=25

# --- Prediction ledger worker (docker-compose "prediction-logger", runs by
# default — not OTC-gated) ---
# Snapshots every active asset into the immutable prediction ledger and
# grades matured predictions on this interval. Hourly by default; a shorter
# interval just logs redundant near-duplicate snapshots, not more signal.
PREDICTION_LOG_INTERVAL_SECONDS=3600

# --- Optional OTC/micro-cap module (disabled by default) ---
# The mainstream platform runs on the Asset Universe Manager (GET/POST
# /api/v1/universe), seeded with 20 mainstream stocks/ETFs — see
# app/services/universe/manager.py. The original continuous OTC penny-stock
# scanner (app/workers/scan_scheduler.py, the docker-compose "scanner"
# service under the "otc" profile) and OTC-specific manipulation checks
# (app/services/otc/manipulation.py) still exist but stay off unless you
# explicitly opt in here.
OTC_MODULE_ENABLED=false

# --- ML ---
MODEL_ARTIFACT_DIR=./model_artifacts
RANDOM_SEED=42
