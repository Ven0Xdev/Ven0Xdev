# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production

# --- Database (TimescaleDB/PostgreSQL). Leave unset to use the SQLite
# dev/test fallback automatically. ---
# DATABASE_URL=postgresql+psycopg://ven0x:ven0x@localhost:5432/ven0x_otc
USE_SQLITE_FALLBACK=true

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Market data provider ---
# mock = deterministic synthetic OTC data, no keys required, fully runnable
# polygon | finnhub | otc_markets = real vendors, require the matching API key
# and an implementation in services/data_providers/real_providers.py
MARKET_DATA_PROVIDER=mock
POLYGON_API_KEY=
FINNHUB_API_KEY=
OTC_MARKETS_API_KEY=
SEC_EDGAR_USER_AGENT="Ven0X OTC Intelligence Platform contact@example.com"
NEWS_API_KEY=

# --- Chat assistant ---
# template = fully offline, deterministic, grounded rule-based assistant (default)
# llm = routes to Anthropic; requires ANTHROPIC_API_KEY
CHAT_BACKEND=template
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5

# --- Continuous scan worker ---
SCAN_INTERVAL_SECONDS=900
UNIVERSE_MAX_TICKERS=2000

# --- ML ---
MODEL_ARTIFACT_DIR=./model_artifacts
RANDOM_SEED=42
