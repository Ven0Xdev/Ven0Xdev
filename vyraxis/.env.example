# VYRAXIS configuration.
#
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Nesting uses "__": VYRAXIS_<SECTION>__<FIELD>.
#
# THIS FILE MUST NEVER CONTAIN A REAL SECRET. It documents variable names only.
# VYRAXIS does not read, request or store a private key or seed phrase anywhere,
# and there is no configuration that makes it do so.

# ---------------------------------------------------------------- application
VYRAXIS_APP__ENVIRONMENT=local           # local | test | staging | production
VYRAXIS_APP__LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
VYRAXIS_APP__LOG_FORMAT=json             # json (production) | console (dev)
VYRAXIS_APP__INSTANCE_ID=local-1         # distinguishes concurrent ingest workers

# ------------------------------------------------------------------- database
# PostgreSQL only. The asyncpg driver is required; a plain postgresql:// URL is
# upgraded automatically.
VYRAXIS_DATABASE__URL=postgresql+asyncpg://vyraxis:CHANGE_ME@localhost:5432/vyraxis
VYRAXIS_DATABASE__POOL_SIZE=5
VYRAXIS_DATABASE__MAX_OVERFLOW=5
VYRAXIS_DATABASE__ECHO_SQL=false

# --------------------------------------------------------------------- solana
# Any Solana JSON-RPC provider works: a hosted endpoint, or your own validator.
# Some providers put the API key in the URL - that is why VYRAXIS redacts
# credentials from every URL it logs.
VYRAXIS_SOLANA__RPC_HTTP_URL=https://api.mainnet-beta.solana.com
VYRAXIS_SOLANA__RPC_WS_URL=wss://api.mainnet-beta.solana.com
VYRAXIS_SOLANA__PROVIDER_NAME=public-mainnet   # recorded on every stored event
VYRAXIS_SOLANA__COMMITMENT=confirmed           # processed | confirmed | finalized

VYRAXIS_SOLANA__REQUEST_TIMEOUT_SECONDS=15
VYRAXIS_SOLANA__MAX_REQUEST_ATTEMPTS=4
VYRAXIS_SOLANA__WS_CONNECT_TIMEOUT_SECONDS=15
VYRAXIS_SOLANA__WS_PING_INTERVAL_SECONDS=20
VYRAXIS_SOLANA__WS_PING_TIMEOUT_SECONDS=20
# Must exceed the ping interval, else a healthy idle socket is recycled forever.
VYRAXIS_SOLANA__WS_STALE_AFTER_SECONDS=90
VYRAXIS_SOLANA__RECONNECT_INITIAL_BACKOFF_SECONDS=1
VYRAXIS_SOLANA__RECONNECT_MAX_BACKOFF_SECONDS=60
VYRAXIS_SOLANA__RECONNECT_BACKOFF_MULTIPLIER=2
VYRAXIS_SOLANA__RECONNECT_JITTER_RATIO=0.25
VYRAXIS_SOLANA__MAX_RECONNECT_ATTEMPTS=0       # 0 = retry forever, capped backoff

# ------------------------------------------------------------------ ingestion
# JSON array of program IDs. Empty uses the built-in defaults - run
# `vyraxis programs verify` before trusting them against mainnet.
VYRAXIS_INGESTION__WATCHED_PROGRAMS=[]
VYRAXIS_INGESTION__NORMALIZED_QUEUE_SIZE=10000
VYRAXIS_INGESTION__PERSIST_BATCH_SIZE=200
VYRAXIS_INGESTION__PERSIST_FLUSH_INTERVAL_SECONDS=1.0
VYRAXIS_INGESTION__DEDUP_CACHE_SIZE=200000
# false (default) applies backpressure; true sheds load. Drops are always
# counted and logged either way - never silent.
VYRAXIS_INGESTION__DROP_ON_FULL_QUEUE=false

# --------------------------------------------------------------- observations
VYRAXIS_OBSERVATIONS__HORIZONS_SECONDS=[30,60,300,900,1800,3600,21600,86400]

# --------------------------------------------------------------------- safety
# Live trading is NOT implemented. Setting this to true is rejected at startup;
# it is not a feature flag, it is an explicit refusal. See docs/ROADMAP.md.
VYRAXIS_SAFETY__LIVE_TRADING_ENABLED=false
VYRAXIS_SAFETY__PAPER_TRADING_ENABLED=false

# ------------------------------------------------------------------------ api
VYRAXIS_API__HOST=127.0.0.1
VYRAXIS_API__PORT=8080

# --------------------------------------------------------------------- tests
# Integration tests run against a real PostgreSQL database. Without this they
# are skipped, not silently passed.
# VYRAXIS_TEST_DATABASE_URL=postgresql+asyncpg://vyraxis@localhost:5432/vyraxis_test
